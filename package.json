{
  "name": "react-adblocker-detect",
  "version": "2.0.0",
  "description": "A lightweight React component that detects if an ad blocker is active in the user's browser. It allows developers to conditionally render UI elements or trigger custom actions when ad blocking is detected, enhancing user messaging or monetization strategies.",
  "keywords": [
    "react",
    "nextjs",
    "next.js",
    "adblock",
    "adblocker",
    "adblock detector"
  ],
  "homepage": "https://faraasat.github.io/react-adblocker-detect",
  "bugs": {
    "url": "https://github.com/faraasat/react-adblocker-detect/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faraasat/react-adblocker-detect.git"
  },
  "license": "MIT",
  "author": "Farasat Ali <63093876+faraasat@users.noreply.github.com>",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/faraasat"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./style.css": "./dist/index.css",
    "./dist/*.css": "./dist/*.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "standard-version",
    "prepublishOnly": "npm run typecheck && npm run test -- --run && npm run build",
    "example:dev": "npm run build && npm --prefix example install && npm --prefix example run dev",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "standard-version": "^9.5.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
